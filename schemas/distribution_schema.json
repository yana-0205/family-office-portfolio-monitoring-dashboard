{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distribution_schema.json",
  "title": "Distribution Extraction Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "document_type",
    "document_filename",
    "extraction_mode",
    "source_path",
    "fund_name_raw",
    "fund_name_mapped",
    "investor_entity",
    "notice_date",
    "reporting_period",
    "currency",
    "extracted_fields",
    "source_references",
    "confidence_score",
    "extraction_status",
    "validation_status",
    "review_status",
    "warnings"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "examples": ["PDF_001"]
    },
    "document_type": {
      "const": "distribution"
    },
    "document_filename": {
      "type": "string"
    },
    "extraction_mode": {
      "type": "string",
      "enum": ["baseline", "llm"]
    },
    "source_path": {
      "type": "string"
    },
    "fund_name_raw": {
      "type": ["string", "null"]
    },
    "fund_name_mapped": {
      "type": ["string", "null"]
    },
    "investor_entity": {
      "type": ["string", "null"]
    },
    "notice_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "reporting_period": {
      "type": ["string", "null"]
    },
    "currency": {
      "type": ["string", "null"]
    },
    "extracted_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_date",
        "gross_distribution",
        "net_distribution",
        "return_of_capital",
        "realized_gain",
        "income",
        "recallable_distribution",
        "withholding",
        "component_sum_check",
        "transaction_components"
      ],
      "properties": {
        "payment_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "gross_distribution": {
          "type": ["number", "null"]
        },
        "net_distribution": {
          "type": ["number", "null"]
        },
        "return_of_capital": {
          "type": ["number", "null"]
        },
        "realized_gain": {
          "type": ["number", "null"]
        },
        "income": {
          "type": ["number", "null"]
        },
        "recallable_distribution": {
          "type": ["number", "null"]
        },
        "withholding": {
          "type": ["number", "null"]
        },
        "component_sum_check": {
          "type": ["number", "null"]
        },
        "transaction_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_type", "amount", "currency"],
            "properties": {
              "component_type": {
                "type": "string"
              },
              "amount": {
                "type": ["number", "null"]
              },
              "currency": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "field_name", "evidence_text"],
        "properties": {
          "page": {
            "type": ["integer", "string"]
          },
          "field_name": {
            "type": "string"
          },
          "evidence_text": {
            "type": "string"
          }
        }
      }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extraction_status": {
      "type": "string",
      "enum": ["not_started", "extracted", "partial", "failed"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed", "warning"]
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "approved", "needs_review", "rejected"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
